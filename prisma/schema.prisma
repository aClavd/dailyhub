generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7 l'URL di connessione non sta più qui: per la CLI (migrate)
  // è in prisma.config.ts (DIRECT_URL), per PrismaClient a runtime è nel
  // driver adapter in src/lib/prisma.ts (DATABASE_URL, pooler).
}

/// Una voce di diario per un utente in un giorno — record unico che copre
/// journaling, abitudini, peso, sonno e umore (widget "Diario" unificato,
/// non più blocchi separati). Un utente = un Google `sub`.
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  /// Formato "YYYY-MM-DD", stesso fuso del client che scrive.
  date      String
  mood      String?
  obiettivo String   @default("")
  testo     String   @default("")
  wins      String[] @default([])
  /// { [nomeAbitudine]: fatta oggi sì/no }. La lista dei nomi vive in
  /// BoardLayout.habitList (condivisa tra i giorni), qui solo lo stato.
  habits      Json    @default("{}")
  weight      Float?
  sleepHours  Float?
  /// Sessioni di studio (blocchi da 25 min) completate in questo giorno —
  /// pilota anche la pausa lunga stile Pomofocus (ogni 4a sessione).
  pomodoroSessions Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

/// Preferenze dell'utente indipendenti da QUALE layout (SavedLayout, sotto)
/// sta guardando — una riga sola per utente. `layout`/`order`/`sizes`
/// restano solo come fonte per la migrazione automatica verso SavedLayout
/// (Fase 5.4): non più scritti per i blocchi dopo la prima migrazione.
model BoardLayout {
  userId    String   @id
  /// @deprecated — non più letto dal codice nuovo, tenuto solo per la
  /// migrazione automatica delle board create prima di `layout`.
  order     String[]
  /// @deprecated
  sizes     Json     @default("{}")
  /// @deprecated — sostituito da SavedLayout.layout. Resta finché serve da
  /// sorgente per la migrazione automatica al primo accesso di un utente
  /// senza ancora nessuna SavedLayout.
  layout    Json     @default("[]")
  railCollapsed Boolean @default(false)
  /// Comprimi/espandi del pannello destro (Right Sidebar / Personal
  /// Attention Center) — stesso schema di railCollapsed sopra, campo a
  /// parte perché sono due barre indipendenti (si può tenere una
  /// compressa e l'altra no).
  rightPanelCollapsed Boolean @default(false)
  /// Nomi delle abitudini personalizzate, condivisi tra tutti i giorni del
  /// widget Diario (lo stato "fatta/non fatta" invece è per giorno, su
  /// JournalEntry.habits) — e tra tutti i SavedLayout: non ha senso che
  /// cambino solo perché hai aperto un'altra disposizione dei blocchi.
  habitList String[] @default([])
  updatedAt DateTime @updatedAt
}

/// Un layout salvato e nominato (es. "Studio", "Lavoro", "Serata") — un
/// utente può averne più d'uno, esattamente uno attivo alla volta
/// (Fase 5.4). Solo la disposizione dei blocchi: railCollapsed/habitList
/// restano su BoardLayout, condivisi tra tutti i layout dello stesso
/// utente (vedi il commento lì).
model SavedLayout {
  id     String @id @default(cuid())
  userId String
  name   String
  /// WidgetPlacement[] = { type, x, y, w, h } in celle logiche — stessa
  /// forma di BoardLayout.layout.
  layout Json @default("[]")
  /// Esattamente una riga per utente è true — applicato in codice
  /// (switchBoardLayout aggiorna tutte le righe dell'utente in una sola
  /// transazione), non un vincolo del database.
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

/// Regola per segnalare la posta importante (sotto-stringa, case-
/// insensitive, confrontata con mittente E oggetto) — un match su una
/// mail non ancora notificata fa comparire un avviso (toast-context.tsx).
/// Le regole le decide l'utente stesso: a differenza di mailEmphasis
/// (Fase 5.2, "è recente"), qui non c'è nessuna soglia arbitraria da
/// inventare, è lui a dire cosa conta.
model MailFilter {
  id        String   @id @default(cuid())
  userId    String
  pattern   String
  createdAt DateTime @default(now())

  @@unique([userId, pattern])
  @@index([userId])
}

/// Contenuto del blocco Note — una riga per utente, contenuto continuo
/// senza scadenza (non è per giorno come JournalEntry). Prima era solo
/// localStorage; passato al DB come tutto il resto.
model NoteWidget {
  userId    String   @id
  text      String   @default("")
  updatedAt DateTime @updatedAt
}

/// Contenuto del blocco Lettura — un libro alla volta, una riga per
/// utente. Stesso motivo di NoteWidget sopra.
model LetturaWidget {
  userId    String   @id
  titolo    String   @default("")
  pagina    Int      @default(0)
  totale    Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Collegamento Spotify per il widget "in riproduzione ora" in testata —
/// connessione a parte, non l'identità con cui si accede (quella resta
/// Google): un utente può avere o non avere Spotify collegato. Niente
/// adapter Auth.js coinvolto, gestita a mano (vedi src/lib/spotify.ts) come
/// Libero, solo che qui è OAuth invece di credenziali statiche.
model SpotifyConnection {
  userId       String   @id
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}
