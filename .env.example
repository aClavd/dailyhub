# ─────────────────────────────────────────────
#  DailyHub — variabili d'ambiente
#  Copia in .env.local e compila. NON committare .env.local.
# ─────────────────────────────────────────────

# Auth.js — chiave per firmare i cookie di sessione.
# Genera con:  npx auth secret   (oppure: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth — istruzioni in docs/SETUP-GOOGLE.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# DailyHub è un'app personale a un solo utente (Pre-Deploy Security Audit v1):
# solo questa email può accedere, qualunque altro account Google viene
# rifiutato PRIMA che venga creata una sessione. Senza questa variabile
# l'accesso è negato a chiunque, compreso il proprietario (fallisce chiuso,
# non aperto) — va impostata anche in locale, non solo su Vercel.
ALLOWED_EMAIL=

# Fisso, non lasciato "indovinare" da Auth.js richiesta per richiesta —
# altrimenti l'accesso Google va in redirect_uri_mismatch in modo intermittente
# (vedi docs/SETUP-GOOGLE.md). In dev usa sempre 127.0.0.1, non localhost.
AUTH_URL=http://127.0.0.1:3000
# In produzione: l'URL pubblico, es. AUTH_URL=https://dailyhub.vercel.app

# Libero Mail via IMAP — serve dalla Fase 3. Istruzioni in docs/SETUP-LIBERO.md
LIBERO_EMAIL=
LIBERO_APP_PASSWORD=

# Spotify OAuth — widget "in riproduzione ora" in testata. Istruzioni in docs/SETUP-SPOTIFY.md
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=
